    "def pares_ordenados(sim, nombres):\n",
    "    n = len(nombres)\n",
    "    filas, columnas = torch.triu_indices(n, n, offset=1)\n",
    "    scores = sim[filas,columnas]\n",
    "    indices_ordenados = torch.argsort(scores, descending=True)\n",
    "    pares = [\n",
    "        (nombres[filas[idx]], nombres[columnas[idx]], scores[idx].item())\n",
    "        for idx in indices_ordenados\n",
    "    ]\n",
    "    return pares\n",
    "\n",
    "pares_bow = pares_ordenados(sim_bow, nombres)\n",
    "\n",
    "print(\"PARES MAS SIMILARES\")\n",
    "for doc1, doc2, score in pares_bow[:5]:\n",
    "    print(f\"{doc1} | {doc2}: {score:.4f}\")\n",
    "\n",
    "print(\"PARES MENOS SIMILARES\")\n",
    "for doc1, doc2, score in pares_bow[-5:][::-1]:\n",
    "    print(f\"{doc1} | {doc2}: {score:.4f}\")"
   ]
