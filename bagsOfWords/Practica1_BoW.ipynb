    "def tfidf(bow, smooth=True):\n",
    "    N = bow.shape[0]\n",
    "\n",
    "    total_palabras_doc = bow.sum(dim=1, keepdim=True).clamp(min=1e-9)\n",
    "    tf = bow / total_palabras_doc\n",
    "\n",
    "    df = (bow > 0).sum(dim=0).float()\n",
    "\n",
    "    if smooth:\n",
    "        idf = torch.log((N+1) / (df+1)) + 1.0\n",
    "    else:\n",
    "        idf = torch.log(N / df.clamp(min=1e-9))\n",
    "\n",
    "    return tf * idf\n",
    "\n",
    "X_tfidf = tfidf(bow)\n",
    "sim_tfidf = matriz_similitud(X_tfidf)\n",
    "\n",
    "pares_tfidf = pares_ordenados(sim_tfidf, nombres)\n",
    "\n",
    "diagonal = torch.eye(len(nombres), dtype=torch.bool)\n",
    "\n",
    "plt.figure(figsize=(10, 8))\n",
    "sns.heatmap(sim_tfidf.numpy(), mask=diagonal.numpy(), annot=True, fmt=\".2f\", cmap=\"YlGnBu\", \n",
    "            xticklabels=nombres, yticklabels=nombres, vmin=0, vmax=sim_tfidf[~diagonal].max().item())\n",
    "sns.heatmap(sim_tfidf.numpy(), mask=~diagonal.numpy(), annot=True, fmt=\".2f\", cmap=[\"lightgrey\"], cbar=False,\n",
    "            xticklabels=nombres, yticklabels=nombres)\n",
    "plt.title(\"Matriz de Similitud del Coseno (TF-IDF)\")\n",
    "plt.xticks(rotation=45, ha='right')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(pd.DataFrame(sim_tfidf.numpy(), index=nombres, columns=nombres).round(3))\n",
    "\n",
    "print(\"\\n--- COMPARATIVA TOP 5 PARES MÁS SIMILARES ---\")\n",
    "print(f\"{'BoW (Frecuencia cruda)':<32} | {'TF-IDF (Penalizando comunes)':<32}\")\n",
    "print(\"-\" * 67)\n",
    "for (d1_b, d2_b, sc_b), (d1_t, d2_t, sc_t) in zip(pares_bow[:5], pares_tfidf[:5]):\n",
