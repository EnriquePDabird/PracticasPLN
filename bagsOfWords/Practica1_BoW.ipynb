    "def leer_docx(ruta):\n",
    "    doc = Document(str(ruta))\n",
    "    return \"\\n\".join(p.text for p in doc.paragraphs if p.text.strip())\n",
    "\n",
    "\n",
    "def preprocesar(texto):\n",
    "    texto_proc = texto.lower()\n",
    "    texto_proc = re.sub(r\"[^a-záéíóúüñ]+\", \" \", texto_proc)\n",
    "    tokens = texto_proc.split()\n",
    "\n",
    "    filtered_tokens = [w for w in tokens if w not in STOPWORDS]\n",
    "    \n",
    "    return filtered_tokens\n",
    "\n",
    "\n",
    "import nltk; nltk.download(\"stopwords\")\n",
    "from nltk.corpus import stopwords\n",
    "STOPWORDS = set(stopwords.words(\"spanish\"))\n",
    "\n",
    "rutas = sorted(DOCS_DIR.glob(\"*.docx\"))\n",
    "nombres = [r.stem for r in rutas]\n",
    "\n",
    "docs_tokens = []\n",
    "\n",
    "for ruta in rutas:\n",
    "    curr_doc = leer_docx(ruta)\n",
    "    curr_doc_tokens = preprocesar(curr_doc)\n",
    "    docs_tokens.append(curr_doc_tokens)\n",
    "\n",
    "for n, t in zip(nombres, docs_tokens):\n",
    "     print(n, len(t), t[:10])"
   ]
