    "ejemplos_tokens = []\n",
    "\n",
    "frases_ejemplo = [\n",
    "    \"El gato juega en el jardín.\",   \n",
    "    \"El perro duerme en la casa.\",    \n",
    "    \"El niño juega con el perro.\",    \n",
    "    \"El coche es azul.\"              \n",
    "]\n",
    "\n",
    "def preprocesar_ejemplo(texto):\n",
    "    texto_proc = texto.lower()\n",
    "    texto_proc = re.sub(r\"[^a-záéíóúüñ]+\", \" \", texto_proc)\n",
    "    return texto_proc.split()\n",
    "\n",
    "for frase in frases_ejemplo:\n",
    "    frase_procesada = preprocesar_ejemplo(frase)\n",
    "    ejemplos_tokens.append(frase_procesada)\n",
    "\n",
    "vocabulario_ej = sorted(list(set([palabra for doc in ejemplos_tokens for palabra in doc])))\n",
    "\n",
    "palabra2idx_ej = {palabra: i for i, palabra in enumerate(vocabulario_ej)}\n",
    "\n",
    "def vectorizar_ej(tokens):\n",
    "    v = torch.zeros(len(vocabulario_ej), dtype=torch.float32)\n",
    "    for palabra, count in Counter(tokens).items():\n",
    "        if palabra in palabra2idx_ej:\n",
    "            v[palabra2idx_ej[palabra]] = float(count)\n",
    "    return v\n",
    "\n",
    "bow_ejemplos = torch.stack([vectorizar_ej(doc) for doc in ejemplos_tokens])\n",
    "\n",
    "vec_B = bow_ejemplos[1]\n",
    "vec_C = bow_ejemplos[2]\n",
    "\n",
    "similitud_BC = F.cosine_similarity(vec_B.unsqueeze(0), vec_C.unsqueeze(0)).item()\n",
    "\n",
    "print(\"Vocabulario obtenido:\", vocabulario_ej)\n",
    "print(\"Vector Frase B:\", vec_B.int().tolist())\n",
    "print(\"Vector Frase C:\", vec_C.int().tolist())\n",
    "print(f\"Similitud del coseno entre B y C: {similitud_BC:.4f}\")\n"
   ]
  }
