   "source": [
    "vocabulario = sorted(list(set([palabra for doc in docs_tokens for palabra in doc])))\n",
    "\n",
    "palabra2idx = {}\n",
    "\n",
    "for i, palabra in enumerate(vocabulario):\n",
    "    palabra2idx[palabra] = i\n",
    "\n",
    "def vectorizar(tokens):\n",
    "    v = torch.zeros(len(vocabulario))\n",
    "    for palabra, palabra_count in Counter(tokens).items():\n",
    "        v[palabra2idx[palabra]] = palabra_count\n",
    "    return v\n",
    "\n",
    "vectorized_docs = [vectorizar(doc_tokens) for doc_tokens in docs_tokens]\n",
    "bow = torch.stack(vectorized_docs, dim=0)\n",
    "\n",
    "print(bow.shape)"
   ]
